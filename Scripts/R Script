# Cargar datos
Tabla <- read.csv("births.csv")

# Seleccionar variables a analizar
Datos <- data.frame(
  weight = Tabla$weight,
  smoke = Tabla$smoke)

# Prueba t de muestras independientes
t.test(weight ~ smoke, data = Datos)

# Boxplot
library(tidyverse)
ggplot(Datos, aes(x = smoke, y = weight, fill = smoke)) +
  geom_boxplot() +
  labs(
    title = "Peso del bebé según hábito de fumar de la madre",
    x = "Hábito de fumar",
    y = "Peso del bebé"
  ) +
  theme_minimal()

# Violin plot
ggplot(Datos, aes(x = smoke, y = weight, fill = smoke)) +
  geom_violin(trim = FALSE) +
stat_summary(
    fun = mean,
    geom = "crossbar",
    size = 0.5,
    color = "black"
  ) +
  labs(
    title = "Peso del bebé según hábito de fumar de la madre",
    x = "Hábito de fumar",
    y = "Peso del bebé"
  ) +
  theme_minimal()
